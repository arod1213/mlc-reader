[Unit]
Description=APG MLC Refresh API
After=network.service

[Service]
Type=simple
User=luminate
EnvironmentFile=/etc/apg-mlc/environment
WorkingDirectory=/var/lib/apg-mlc
StateDirectory=apg-mlc
ExecStart=/opt/apg-mlc/mlc-reader night-job
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
